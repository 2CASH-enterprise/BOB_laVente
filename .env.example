# Copier en .env et remplir avant de lancer docker compose up -d --build
# Ne jamais committer le fichier .env réel (section 32 — secrets hors code)

ENVIRONMENT=development
DEBUG=true

# Domaine pointé vers ce serveur (DNS A record), utilisé par Caddy pour le HTTPS automatique
DOMAIN=

DATABASE_URL=postgresql+asyncpg://bob:bob@db:5432/bob
REDIS_URL=redis://redis:6379/0

# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v25.0

COMMISSION_FLOOR_PCT=0
COMMISSION_CEILING_PCT=10

# Agent IA (section 13, 20)
LLM_PROVIDER=mistral
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MAX_TOOL_ITERATIONS=5
